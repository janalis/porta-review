<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="he" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>Comment on %review%</source>
        <target>הגב על %review%</target>
      </trans-unit>
      <trans-unit id="2">
        <source>Conversation (%count%)</source>
        <target>שיחה (%count%)</target>
      </trans-unit>
      <trans-unit id="3">
        <source>Copied %url%</source>
        <target>%url% הועתק</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Local review: %id%</source>
        <target>סקירה מקומית: %id%</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Looking for a review…</source>
        <target>מחפש סקירה…</target>
      </trans-unit>
      <trans-unit id="6">
        <source>New comment on %path%:%line%</source>
        <target>תגובה חדשה על %path%:%line%</target>
      </trans-unit>
      <trans-unit id="7">
        <source>No comments yet — press c to write one</source>
        <target>אין עדיין תגובות — לחצו c כדי לכתוב</target>
      </trans-unit>
      <trans-unit id="8">
        <source>No conversation on this line</source>
        <target>אין שיחה בשורה זו</target>
      </trans-unit>
      <trans-unit id="9">
        <source>No review for this branch</source>
        <target>אין סקירה לענף זה</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Open a project file to comment on</source>
        <target>פתחו קובץ בפרויקט כדי להגיב</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Pick a thread, or press c on a line</source>
        <target>בחרו שרשור, או לחצו c על שורה</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Reply</source>
        <target>תשובה</target>
      </trans-unit>
      <trans-unit id="13">
        <source>Reply to %author% on %path%:%line%</source>
        <target>השב ל־%author% על %path%:%line%</target>
      </trans-unit>
      <trans-unit id="14">
        <source>Review (%count% open)</source>
        <target>סקירה (%count% פתוחים)</target>
      </trans-unit>
      <trans-unit id="15">
        <source>Show which review?</source>
        <target>איזו סקירה להציג?</target>
      </trans-unit>
      <trans-unit id="16">
        <source>The branch's pull or merge request</source>
        <target>בקשת ה־pull או ה־merge של הענף</target>
      </trans-unit>
      <trans-unit id="17">
        <source>This review has no link</source>
        <target>לסקירה זו אין קישור</target>
      </trans-unit>
      <trans-unit id="18">
        <source>Thread reopened</source>
        <target>השרשור נפתח מחדש</target>
      </trans-unit>
      <trans-unit id="19">
        <source>Thread resolved</source>
        <target>השרשור נפתר</target>
      </trans-unit>
      <trans-unit id="20">
        <source>outdated</source>
        <target>מיושן</target>
      </trans-unit>
      <trans-unit id="21">
        <source>Show Review</source>
        <target>הצג סקירה</target>
      </trans-unit>
      <trans-unit id="22">
        <source>Refresh Review</source>
        <target>רענן סקירה</target>
      </trans-unit>
      <trans-unit id="23">
        <source>Choose Review…</source>
        <target>בחר סקירה…</target>
      </trans-unit>
      <trans-unit id="24">
        <source>Copy Review Link</source>
        <target>העתק קישור לסקירה</target>
      </trans-unit>
      <trans-unit id="25">
        <source>Show Conversation on This Line</source>
        <target>הצג את השיחה בשורה זו</target>
      </trans-unit>
      <trans-unit id="26">
        <source>Comment on This Line</source>
        <target>הגב על שורה זו</target>
      </trans-unit>
      <trans-unit id="27">
        <source>Show resolved conversations</source>
        <target>הצג שיחות שנפתרו</target>
      </trans-unit>
      <trans-unit id="28">
        <source> S show-resolved </source>
        <target> S show-resolved </target>
      </trans-unit>
    </body>
  </file>
