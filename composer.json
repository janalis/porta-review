{
    "name": "janalis/porta-review",
    "description": "Code review conversations — GitHub pull requests, GitLab merge requests and local agent reviews — in a view, in the diff and in the editor",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "symfony/console": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\ReviewPlugin\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "requires": [
                "diff",
                "git"
            ],
            "commands": {
                "review": "Porta\\ReviewPlugin\\Console\\ReviewCommand"
            },
            "tools": [
                {
                    "name": "git",
                    "purpose": "reads the branch under review",
                    "sources": [
                        [
                            "brew",
                            "git"
                        ]
                    ]
                },
                {
                    "name": "gh",
                    "role": "suggested",
                    "purpose": "GitHub pull requests",
                    "setting": "ghBinary",
                    "sources": [
                        [
                            "brew",
                            "gh"
                        ]
                    ]
                },
                {
                    "name": "glab",
                    "role": "suggested",
                    "purpose": "GitLab merge requests",
                    "setting": "glabBinary",
                    "sources": [
                        [
                            "brew",
                            "glab"
                        ]
                    ]
                }
            ]
        }
    }
}
